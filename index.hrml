<!DOCTYPE html>
<html>

<head>

<title>Dash Shooter Prototype</title>

<style>

body{
    margin:0;
    overflow:hidden;
    background:#000;
}

canvas{
    display:block;
}



/* ================================================= */
/* HUD */
/* ================================================= */

#hud{

    position:fixed;

    top:20px;

    left:20px;

    display:flex;

    flex-direction:column;

    gap:10px;

    z-index:20;

    font-family:'Courier New',monospace;

    user-select:none;

    pointer-events:none;

}



.hud-bar-row{

    display:flex;

    align-items:center;

    gap:12px;

}



.hud-label{

    width:100px;

    color:#eaeaea;

    font-size:13px;

    font-weight:bold;

    letter-spacing:2px;

    text-shadow:0 0 6px rgba(0,0,0,0.9);

}



.hud-bar-track{

    position:relative;

    width:260px;

    height:22px;

    background:linear-gradient(180deg,#141414,#050505);

    border:2px solid #3a3a3a;

    border-radius:6px;

    box-shadow:

        inset 0 2px 4px rgba(0,0,0,0.8),

        0 0 8px rgba(0,0,0,0.6);

    overflow:hidden;

}



.hud-bar-fill{

    position:absolute;

    top:0;

    left:0;

    height:100%;

    width:100%;

    border-radius:4px;

    transition:width 0.25s ease-out;

}



.health-fill{

    background:linear-gradient(180deg,#ff8a5c,#ff2d2d 55%,#b40000);

    box-shadow:0 0 12px rgba(255,45,45,0.85);

}



.power-fill{

    background:linear-gradient(180deg,#7ef9ff,#22b6ff 55%,#0060c6);

    box-shadow:0 0 12px rgba(34,182,255,0.85);

}



.hud-bar-segments{

    position:absolute;

    top:0;

    left:0;

    width:100%;

    height:100%;

    background:repeating-linear-gradient(

        90deg,

        rgba(0,0,0,0.35) 0px,

        rgba(0,0,0,0.35) 2px,

        transparent 2px,

        transparent 26px

    );

}



.hud-value{

    width:36px;

    text-align:right;

    color:#f5f5f5;

    font-size:13px;

    font-weight:bold;

    text-shadow:0 0 6px rgba(0,0,0,0.9);

}



/* ================================================= */
/* HUD STATS (hits / combo / battles won)            */
/* gamified, chunky comic-book styled counters that   */
/* pop with a little scale-punch whenever they change  */
/* ================================================= */

#hud-stats{

    position:fixed;

    top:20px;

    right:20px;

    display:flex;

    gap:14px;

    z-index:20;

    font-family:'Arial Black','Helvetica Neue',Arial,sans-serif;

    user-select:none;

    pointer-events:none;

}



.stat-box{

    display:flex;

    flex-direction:column;

    align-items:center;

    justify-content:center;

    min-width:64px;

    padding:8px 12px;

    border-radius:10px;

    border:4px solid #111;

    box-shadow:

        4px 4px 0 #111,

        0 0 0 2px rgba(255,255,255,0.15) inset;

}



.stat-hits{ background:#ff3b30; }

.stat-combo{ background:#ffd400; }

.stat-wins{ background:#2f7dff; }



.stat-label{

    font-size:11px;

    font-weight:900;

    letter-spacing:1px;

    color:#111;

    text-shadow:1px 1px 0 rgba(255,255,255,0.5);

    margin-bottom:2px;

}



.stat-value{

    font-size:28px;

    font-weight:900;

    line-height:1;

    color:#fff;

    -webkit-text-stroke:2px #111;

    text-shadow:3px 3px 0 #111;

}



@keyframes statPop{

    0%{ transform:scale(1) rotate(0deg); }

    35%{ transform:scale(1.45) rotate(-3deg); }

    65%{ transform:scale(0.92) rotate(2deg); }

    100%{ transform:scale(1) rotate(0deg); }

}



.stat-pop{

    animation:statPop 0.35s ease-out;

}



/* ================================================= */
/* MELEE ATK SWIPE */
/* ================================================= */

.melee-atk-swipe{

    position:fixed;

    width:40px;

    height:40px;

    pointer-events:none;

    border-radius:50%;

    border:5px solid #f5f5f5;

    box-shadow:0 0 10px 2px rgba(255,255,255,0.8);

    transform-origin:center center;

    animation:meleeAtkSwipeAnim 0.28s ease-out forwards;

    z-index:10;

}



@keyframes meleeAtkSwipeAnim{


    0%{

        transform:scale(0.3);

        opacity:1;

        border-width:9px;

    }


    100%{

        transform:scale(3.2);

        opacity:0;

        border-width:0px;

    }


}



/* ================================================= */
/* BOSS STRIKE TELEGRAPH RING */
/* same expanding-ring / fade-out DOM approach as the */
/* player's melee swipe above, instead of a hand-drawn */
/* canvas wedge - reads cleaner and matches the game's */
/* existing "polished" attack-feedback language        */
/* ================================================= */

.boss-strike-ring{

    position:fixed;

    width:64px;

    height:64px;

    pointer-events:none;

    border-radius:50%;

    border:6px solid #ffffff;

    box-shadow:0 0 14px 3px rgba(255,255,255,0.8);

    transform-origin:center center;

    animation:bossStrikeRingAnim 0.4s ease-out forwards;

    z-index:10;

}



@keyframes bossStrikeRingAnim{


    0%{

        transform:scale(0.25);

        opacity:0.95;

        border-width:12px;

    }


    55%{

        opacity:0.8;

    }


    100%{

        transform:scale(4.2);

        opacity:0;

        border-width:0px;

    }


}

</style>

</head>


<body>


<canvas id="game"></canvas>


<div id="hud">


    <div class="hud-bar-row">

        <span class="hud-label">HEALTH</span>


        <div class="hud-bar-track">

            <div class="hud-bar-fill health-fill" id="healthFill"></div>

            <div class="hud-bar-segments"></div>

        </div>


        <span class="hud-value" id="healthValue">100</span>

    </div>



    <div class="hud-bar-row">

        <span class="hud-label">POWER LEVEL</span>


        <div class="hud-bar-track">

            <div class="hud-bar-fill power-fill" id="powerFill"></div>

            <div class="hud-bar-segments"></div>

        </div>


        <span class="hud-value" id="powerValue">100</span>

    </div>


</div>


<div id="hud-stats">


    <div class="stat-box stat-hits">

        <span class="stat-label">HITS</span>

        <span class="stat-value" id="hitsValue">0</span>

    </div>


    <div class="stat-box stat-combo">

        <span class="stat-label">COMBO</span>

        <span class="stat-value" id="comboValue">0</span>

    </div>


    <div class="stat-box stat-wins">

        <span class="stat-label">WINS</span>

        <span class="stat-value" id="winsValue">0</span>

    </div>


</div>


<script>


// =================================================
// CANVAS
// =================================================

const canvas=document.getElementById("game");
const ctx=canvas.getContext("2d");


canvas.width=window.innerWidth;
canvas.height=window.innerHeight;





// =================================================
// WORLD OBJECT
// =================================================

const world={

    width:5000,

    groundY:450

};






// =================================================
// PLAYER OBJECT
// =================================================

const player={

    x:250,

    y:300,


    width:50,

    height:50,


    velocityY:0,

    gravity:0.8,


    jumpPower:15,


    grounded:false,


    smear:0,

    dashDirection:0,


    flying:false,


    health:100,

    maxHealth:100,


    power:1,

    maxPower:1,


    charging:false,

    chargeFrames:0,

    maxChargeFrames:90,


    regening:false,


    // ---- hit feedback (combo streak + knockback) ----
    hitStreak:0,

    lastHitTime:0,

    knockbackVX:0

};




// =================================================
// BOSS FACTORY (SNOWMAN - 3 STACKED CIRCLES)
// same move-set as the player: walk/approach, fire,
// melee lunge, charge dash. Motion is spring/physics
// based so nothing snaps instantly - everything eases,
// squashes, stretches and wobbles like a soft body.
//
// this is now a FACTORY instead of a single literal
// object, so multiple independent bosses can exist at
// once, each with its own fresh arrays/state (radii,
// wobble, step stack, death pieces, etc) instead of
// sharing references.
// =================================================

function createBossState(){

    return {

        x:0,

        y:0,


        // bounding box (used for ground collision / world limits,
        // same idea as player.width/height)
        width:70,

        height:120,


        // circle radii, bottom to top - the "snowman" look
        radii:[35,25,17],


        velocityY:0,

        gravity:0.8,


        grounded:false,


        alive:false,


        health:300,

        maxHealth:300,


        // ---- movement feel ----
        vx:0,                 // current horizontal velocity (eased, not instant)
        facing:1,

        walkBob:0,             // purely visual hop while walking


        // ---- squash & stretch (soft body feel) ----
        squishX:1,
        squishY:1,
        squishVelX:0,
        squishVelY:0,


        // per-circle secondary-motion wobble (bottom to top),
        // lags behind the body so the snowman jiggles like jelly
        circleWobble:[0,0,0],
        circleWobbleVel:[0,0,0],


        bobTime:0,


        // ---- STEP STACK ----
        // the boss slowly cycles through these behavior states,
        // spending stepDuration frames in each before moving on
        stepStack:["search","fire","melee","charge"],

        stepIndex:0,

        stepTimer:0,

        stepDuration:180,


        // shared telegraph/windup progress (0-1) used by fire/melee/charge
        telegraph:0,


        // ---- melee sub-state ----
        meleeState:"idle",   // idle -> anticipate -> lunge -> hold -> return
        meleeTimer:0,
        meleeOriginX:0,
        meleeOriginY:0,
        meleeLungeFromX:0,
        meleeLungeToX:0,
        meleeHasHit:false,


        // ---- charge sub-state ----
        chargeState:"idle",  // idle -> windup -> dash -> settle
        chargeTimer:0,
        chargeFromX:0,
        chargeToX:0,
        chargeHasHit:false,


        // ---- death / respawn cycle ----
        dying:false,

        deathPieces:[],


        // ---- knockback (from qualifying player hits) ----
        knockbackVX:0,


        // which side of the player this boss spawns/respawns on
        side:"right"

    };

}



// two independent bosses, flanking the player - both
// run their own step stack simultaneously
const bosses=[createBossState(), createBossState()];







// =================================================
// CAMERA OBJECT
// =================================================

const camera={

    x:0

};



// how close (in px) the player can get to the screen edge
// before the camera starts scrolling to follow them
const cameraDeadzone=250;







// =================================================
// DASH SETTINGS
// =================================================

const dash={

    distance:200,

    cooldown:false,

    cooldownTime:300

};



// =================================================
// BOSS MOVEMENT / ATTACK SETTINGS
// =================================================

const BOSS_WALK_SPEED = 4.5;

const BOSS_MELEE_RANGE = 140;

const BOSS_MELEE_ANTICIPATE_FRAMES = 22;

const BOSS_MELEE_LUNGE_FRAMES = 12;

const BOSS_MELEE_HOLD_FRAMES = 6;

const BOSS_MELEE_RETURN_FRAMES = 26;

const BOSS_MELEE_DAMAGE = 26;

const PLAYER_MELEE_DAMAGE = 22;

const PLAYER_MELEE_HIT_RADIUS = 70;


const BOSS_CHARGE_WINDUP_FRAMES = 42;

const BOSS_CHARGE_DASH_FRAMES = 16;

const BOSS_CHARGE_SETTLE_FRAMES = 24;

const BOSS_CHARGE_DISTANCE = 260;

const BOSS_CHARGE_DAMAGE = 22;


const BOSS_FIRE_INTERVAL = 55;


const BOSS_HIT_RADIUS = 50;



// =================================================
// CHARGE BLAST SETTINGS (SPACE)
// =================================================

const CHARGE_DRAIN_PER_FRAME = 0.004;

const SHOT_BASE_COST = 0.15;



// =================================================
// POWER CHARGE SETTINGS (S)
// =================================================

const POWER_REGEN_PER_FRAME = 0.008;



// =================================================
// TELEPORT STRIKE (MOVEMENT)
// =================================================

const teleportStrike={

    active:false,

    originX:0,

    originY:0,

    returnDelay:150,

    returnTimeout:null

};







// =================================================
// INPUT OBJECT
// =================================================

const keys={};





// =================================================
// MOUSE OBJECT
// =================================================

const mouse={

    x:0,

    y:0

};



canvas.addEventListener("mousemove",e=>{


    mouse.x=e.clientX;

    mouse.y=e.clientY;


});



// =================================================
// MELEE STRIKE RANGE
// =================================================

const strikeRange = player.width * 5;



canvas.addEventListener("click",e=>{


    let clickX = e.clientX + camera.x;

    let clickY = e.clientY;



    let playerCenterX = player.x + 25;

    let playerCenterY = player.y + 25;



    let distance = Math.sqrt(

        (clickX - playerCenterX)**2 +

        (clickY - playerCenterY)**2

    );



    if(distance <= strikeRange){


        meleeAtkSwipe(e.clientX, e.clientY);


        teleportStrikeTo(clickX, clickY);


        // MELEE HIT CHECK - if the strike point lands close enough

        // to a boss, it counts as a landed melee hit. checks every

        // living boss so either (or both, if overlapping) can be hit.

        for(let b of bosses){


            if(!b.alive) continue;


            let bossCenterX = b.x + b.width/2;

            let bossCenterY = b.y + b.height/2;


            let bossDist = Math.sqrt(

                (clickX - bossCenterX)**2 +

                (clickY - bossCenterY)**2

            );


            if(bossDist <= PLAYER_MELEE_HIT_RADIUS){


                damageBoss(b, PLAYER_MELEE_DAMAGE, clickX);


                spawnBossHitEffect(clickX, clickY, "#ffffff");


            }


        }


    }


});







// =================================================
// ACTIVE OBJECTS
// PROJECTILES / EFFECTS
// =================================================

const activeObjects=[];



// =================================================
// FLAME PARTICLES (CHARGE FX AROUND PLAYER / BOSS,
// also reused for the knockback-slide dust trail)
// =================================================

const flameParticles=[];



// =================================================
// MATH / EASING HELPERS
// =================================================

function lerp(a,b,t){

    return a+(b-a)*t;

}


function clamp(v,min,max){

    return Math.max(min,Math.min(max,v));

}


function easeOutCubic(t){

    return 1-Math.pow(1-t,3);

}


function easeInCubic(t){

    return t*t*t;

}


// slight overshoot on the way out - gives a soft, springy
// "settle" instead of a hard stop
function easeOutBack(t){

    const c1=1.70158;

    const c3=c1+1;


    return 1 + c3*Math.pow(t-1,3) + c1*Math.pow(t-1,2);

}


// generic critically-damped-ish spring step. mutates nothing -
// returns [newPos,newVel] so callers decide what to store.
function springStep(pos,vel,target,stiffness,damping){

    let force=(target-pos)*stiffness - vel*damping;

    vel+=force;

    pos+=vel;


    return [pos,vel];

}





// =================================================
// FIRE ORB OBJECT
// =================================================

function fireOrb(chargeLevel){


    chargeLevel = chargeLevel || 0;



    // LOCK TARGET NOW

    let targetX = mouse.x + camera.x;

    let targetY = mouse.y;



    let originX = player.x+25;

    let originY = player.y+25;



    let angle=Math.atan2(

        targetY - originY,

        targetX - originX

    );




    activeObjects.push({

        type:"orb",

        owner:"player",


        x:originX,

        y:originY,


        targetX:targetX,

        targetY:targetY,


        dx:Math.cos(angle),

        dy:Math.sin(angle),


        speed:15,


        size:12 + chargeLevel*30,


        glow:25 + chargeLevel*45,


        chargeLevel:chargeLevel

    });



}







// =================================================
// BOSS FIRE ORB
// same shot mechanic as the player's SPACE blast,
// aimed at the player instead of the mouse cursor
// =================================================

function bossFireOrb(boss, chargeLevel){


    chargeLevel = chargeLevel || 0;


    let targetX = player.x + player.width/2;

    let targetY = player.y + player.height/2;


    let originX = boss.x + boss.width/2;

    let originY = boss.y + boss.radii[2];


    let angle=Math.atan2(

        targetY - originY,

        targetX - originX

    );


    activeObjects.push({

        type:"orb",

        owner:"boss",


        x:originX,

        y:originY,


        targetX:targetX,

        targetY:targetY,


        dx:Math.cos(angle),

        dy:Math.sin(angle),


        speed:13,


        size:14 + chargeLevel*30,


        glow:25 + chargeLevel*45,


        chargeLevel:chargeLevel

    });


    // recoil kick - fire pushes the boss's body back slightly
    // and gives it a satisfying compress/pop instead of firing
    // from a perfectly rigid pose

    boss.squishVelX -= 0.12*boss.facing;

    boss.squishVelY += 0.1;


}



// =================================================
// TELEPORT STRIKE (MOVEMENT)
// =================================================

function teleportStrikeTo(worldX,worldY){



    // FIRST HIT IN A CHAIN - REMEMBER TRUE ORIGIN

    if(!teleportStrike.active){


        teleportStrike.originX=player.x;

        teleportStrike.originY=player.y;

        teleportStrike.active=true;


    }




    // CANCEL ANY PENDING RETURN - WE'RE CHAINING

    if(teleportStrike.returnTimeout){


        clearTimeout(teleportStrike.returnTimeout);


    }




    // TELEPORT TO CLICKED SPOT

    player.x = worldX - 25;

    player.y = worldY - 25;




    // QUEUE THE RETURN - FIRES ONLY IF NO MORE CLICKS COME IN

    teleportStrike.returnTimeout=setTimeout(()=>{


        player.x=teleportStrike.originX;

        player.y=teleportStrike.originY;


        teleportStrike.active=false;

        teleportStrike.returnTimeout=null;


    },teleportStrike.returnDelay);



}

// =================================================
// MELEE ATK SWIPE
// =================================================

function meleeAtkSwipe(screenX,screenY){


    let el=document.createElement("div");


    el.className="melee-atk-swipe";


    el.style.left=(screenX-20)+"px";

    el.style.top=(screenY-20)+"px";


    document.body.appendChild(el);



    el.addEventListener("animationend",()=>{


        el.remove();


    });


}







// =================================================
// EXPLOSION OBJECT
// explosions now also trigger screen shake directly,
// scaled by the charge level (i.e. by how big/damaging
// the underlying hit was) - a weak orb pop barely
// rattles the screen, a big charged orb really lands.
// =================================================

function createExplosion(x,y,chargeLevel){


    chargeLevel = chargeLevel || 0;


    activeObjects.push({

        type:"explosion",


        x:x,

        y:y,


        radius:5 + chargeLevel*15,

        growth:4 + chargeLevel*6,

        life:1

    });


    triggerScreenShake(6 + chargeLevel*24);


}


// =================================================
// FLAME / DUST PARTICLE FUNCTIONS
// =================================================

function spawnFlameParticle(color,owner){


    color = color || "orange";

    owner = owner || player;


    let cx = owner.x + owner.width/2;

    let cy = owner.y + owner.height/2;


    let edgeAngle = Math.random()*Math.PI*2;


    let spawnRadius = 30 + Math.random()*10;


    flameParticles.push({


        x: cx + Math.cos(edgeAngle)*spawnRadius,

        y: cy + Math.sin(edgeAngle)*spawnRadius,


        vx: (Math.random()-0.5)*1.2,

        vy: -1 - Math.random()*1.5,


        size: 6 + Math.random()*8,


        life:1,


        color:color


    });


}



// dust kicked up along the ground while an entity is
// being slid by knockback - grounds the slide as a real
// physical shove instead of just a screen-space nudge
function spawnDustParticle(entity){


    let footX = entity.x + entity.width/2;


    flameParticles.push({


        x: footX + (Math.random()-0.5)*24,

        y: world.groundY - Math.random()*6,


        vx: (Math.random()-0.5)*1.5,

        vy: -0.4 - Math.random()*0.6,


        size: 8 + Math.random()*10,


        life:1,


        color:"dust"


    });


}



function updateFlameParticles(){


    for(let i=flameParticles.length-1;i>=0;i--){


        let p=flameParticles[i];


        p.x += p.vx;

        p.y += p.vy;


        p.life -= 0.045;

        p.size *= 0.96;


        if(p.life<=0){

            flameParticles.splice(i,1);

        }


    }


}



// =================================================
// FLAME / DUST PARTICLE DRAW
// =================================================

function drawFlameParticles(){


    for(let p of flameParticles){


        ctx.save();


        ctx.globalAlpha = Math.max(0,p.life);


        let isCyan = p.color==="cyan";

        let isWhite = p.color==="white";

        let isDust = p.color==="dust";


        ctx.shadowBlur = isDust ? 6 : 18;

        ctx.shadowColor = isDust

            ? "rgba(150,130,100,0.5)"

            : (isCyan ? "#22b6ff" : (isWhite ? "#ffffff" : "orange"));


        let grad = ctx.createRadialGradient(

            p.x, p.y, 0,

            p.x, p.y, p.size

        );


        if(isDust){

            grad.addColorStop(0,"rgba(214,196,158,0.85)");

            grad.addColorStop(0.6,"rgba(163,140,108,0.45)");

            grad.addColorStop(1,"rgba(120,100,80,0)");

        }
        else if(isCyan){

            grad.addColorStop(0,"#eafcff");

            grad.addColorStop(0.5,"#22b6ff");

            grad.addColorStop(1,"rgba(0,96,198,0)");

        }
        else if(isWhite){

            grad.addColorStop(0,"#ffffff");

            grad.addColorStop(0.5,"#e8e8e8");

            grad.addColorStop(1,"rgba(255,255,255,0)");

        }
        else{

            grad.addColorStop(0,"#fff59d");

            grad.addColorStop(0.5,"#ff9800");

            grad.addColorStop(1,"rgba(255,60,0,0)");

        }


        ctx.fillStyle = grad;


        ctx.beginPath();

        ctx.arc(p.x, p.y, Math.max(p.size,0), 0, Math.PI*2);

        ctx.fill();


        ctx.restore();


    }


}







// =================================================
// UPDATE ACTIVE OBJECTS
// =================================================

// =================================================
// ORB CLASH CHECK
// if a player orb and a boss orb touch mid-air, the
// larger orb punches through at full strength and
// destroys the smaller one outright. only equal-size
// orbs mutually cancel each other out.
// =================================================

function checkOrbClashes(){


    const CLASH_EQUAL_SIZE_TOLERANCE = 1.5;


    for(let i=0;i<activeObjects.length;i++){


        let a=activeObjects[i];


        if(a.type!=="orb" || a.clashed) continue;


        for(let j=i+1;j<activeObjects.length;j++){


            let b=activeObjects[j];


            if(b.type!=="orb" || b.clashed) continue;


            if(a.owner===b.owner) continue;


            let d=Math.sqrt((a.x-b.x)**2+(a.y-b.y)**2);


            if(d<=a.size+b.size){


                let sizeDiff = a.size - b.size;


                if(Math.abs(sizeDiff) <= CLASH_EQUAL_SIZE_TOLERANCE){


                    // evenly matched - both cancel out

                    let mx=(a.x+b.x)/2;

                    let my=(a.y+b.y)/2;


                    createExplosion(mx,my, Math.max(a.chargeLevel,b.chargeLevel)+0.15);


                    spawnBossHitEffect(mx,my,"#ffffff");


                    a.clashed=true;

                    b.clashed=true;


                }
                else{


                    // bigger orb punches through unaffected,

                    // smaller orb is destroyed on the spot

                    let winner = sizeDiff>0 ? a : b;

                    let loser = sizeDiff>0 ? b : a;


                    loser.clashed=true;


                    createExplosion(loser.x, loser.y, loser.chargeLevel*0.6);


                    spawnBossHitEffect(loser.x, loser.y, "#ffffff");


                    // winner keeps its position/size/velocity exactly

                    // as-is - no penalty for punching through


                }


            }


        }


    }


}



function updateActiveObjects(){


checkOrbClashes();




for(let i=activeObjects.length-1;i>=0;i--){



let obj=activeObjects[i];




// -------------------------------
// ORB UPDATE
// -------------------------------

if(obj.type==="orb"){


if(obj.clashed){

    activeObjects.splice(i,1);

    continue;

}



obj.x += obj.dx * obj.speed;

obj.y += obj.dy * obj.speed;




let distance=Math.sqrt(

    (obj.targetX-obj.x)**2 +

    (obj.targetY-obj.y)**2

);





if(distance <= obj.speed){


createExplosion(

obj.targetX,

obj.targetY,

obj.chargeLevel

);



// player shots hurt any boss they land on, boss shots
// hurt the player (damage is driven directly by the
// orb's actual size, not a separate chargeLevel formula)

if(obj.owner==="player"){


    for(let b of bosses){


        if(!b.alive) continue;


        let bcx=b.x+b.width/2;

        let bcy=b.y+b.height/2;


        let d=Math.sqrt((bcx-obj.targetX)**2+(bcy-obj.targetY)**2);


        if(d<=BOSS_HIT_RADIUS+obj.chargeLevel*30){

            damageBoss(b, orbDamageFromSize(obj.size,"player"), obj.targetX);


            spawnBossHitEffect(obj.targetX,obj.targetY,"#ffffff");

        }


    }

}


if(obj.owner==="boss"){


    let pcx=player.x+player.width/2;

    let pcy=player.y+player.height/2;


    let d=Math.sqrt((pcx-obj.targetX)**2+(pcy-obj.targetY)**2);


    if(d<=35+obj.chargeLevel*30){

        damagePlayer(orbDamageFromSize(obj.size,"boss"), obj.x);


        spawnBossHitEffect(obj.targetX,obj.targetY,"#ffb347");

    }

}



activeObjects.splice(i,1);


}



}






// -------------------------------
// BOSS HIT RING UPDATE
// -------------------------------

if(obj.type==="bossHit"){


obj.radius += 6;

obj.life -= 0.09;


if(obj.life<=0){

activeObjects.splice(i,1);

}


}



// -------------------------------
// BOSS HIT SPARK UPDATE
// -------------------------------

if(obj.type==="bossHitSpark"){


obj.x += obj.dx;

obj.y += obj.dy;


obj.dx *= 0.9;

obj.dy *= 0.9;


obj.life -= 0.07;


if(obj.life<=0){

activeObjects.splice(i,1);

}


}



// -------------------------------
// EXPLOSION UPDATE
// -------------------------------

if(obj.type==="explosion"){



obj.radius+=obj.growth;

obj.life-=0.05;



if(obj.life<=0){

activeObjects.splice(i,1);

}



}



}



}



// =================================================
// ORB DAMAGE FROM SIZE
// damage is derived directly from the orb's actual
// rendered size instead of a parallel chargeLevel
// formula, so size and damage can never drift apart -
// a bigger orb is always meaningfully more damage.
// =================================================

function orbDamageFromSize(size, owner){


    if(owner==="player"){


        // player orb: size 12 (charge 0) -> 42 (charge 1)
        // damage:      10                -> 35

        return 10 + (size-12) * (25/30);


    }
    else{


        // boss orb: size 14 (charge 0) -> 44 (charge 1)
        // damage:    8                 -> 28

        return 8 + (size-14) * (20/30);


    }


}



// =================================================
// HIT FEEDBACK SETTINGS (KNOCKBACK + SHAKE)
// two independent triggers per side:
//  - combo: N hits taken in a row / short window
//  - single hit: any hit at or above a damage threshold,
//    even the very first hit taken
//
// KNOCKBACK_FORCE / KNOCKBACK_DECAY are tuned together
// so a triggered knockback slides ~150px total before
// bleeding out - a real shove, not a jitter.
// =================================================

const COMBO_HIT_THRESHOLD = 4;

const COMBO_HIT_WINDOW_MS = 1200;

const HIGH_DAMAGE_THRESHOLD = 20;


const KNOCKBACK_FORCE = 18;

const KNOCKBACK_DECAY = 0.885;


const BOSS_KNOCKBACK_FORCE = 18;

const BOSS_HIGH_DAMAGE_THRESHOLD = 20;


const SHAKE_DURATION_FRAMES = 18;

const SHAKE_MAGNITUDE = 14;


const screenShake = {

    time:0,

    magnitude:0

};



function triggerScreenShake(magnitude){


    magnitude = magnitude || SHAKE_MAGNITUDE;


    // if a stronger shake is already mid-flight, don't let a

    // weaker one cut it short - take whichever is bigger

    if(screenShake.time<=0 || magnitude>=screenShake.magnitude){

        screenShake.magnitude = magnitude;

    }


    screenShake.time = SHAKE_DURATION_FRAMES;


}



function triggerPlayerKnockback(sourceX){


    let playerCenterX = player.x + player.width/2;


    let dir = sourceX===undefined

        ? (Math.random()<0.5 ? -1 : 1)

        : (playerCenterX < sourceX ? -1 : 1);


    player.knockbackVX = dir*KNOCKBACK_FORCE;


    if(!player.flying){


        player.velocityY = -6;

        player.grounded = false;


    }


    triggerScreenShake();


}



// mirror of triggerPlayerKnockback, but for a boss being

// shoved back by a qualifying player hit

function triggerBossKnockback(boss, sourceX){


    let bossCenterX = boss.x + boss.width/2;


    let dir = sourceX===undefined

        ? (Math.random()<0.5 ? -1 : 1)

        : (bossCenterX < sourceX ? -1 : 1);


    boss.knockbackVX = dir*BOSS_KNOCKBACK_FORCE;


    triggerScreenShake();


}



// =================================================
// HUD STAT COUNTERS (hits landed / combo / battles won)
// =================================================

let hitsLanded = 0;

let hudCombo = 0;

let battlesWon = 0;



function popStat(el){


    el.classList.remove("stat-pop");


    // force a reflow so the animation can restart even if

    // it was just applied a moment ago

    void el.offsetWidth;


    el.classList.add("stat-pop");


}



// =================================================
// DAMAGE HELPERS
// =================================================

function damagePlayer(amount, sourceX){


    player.health -= amount;


    if(player.health<0) player.health=0;



    // taking a hit breaks the player's own outgoing combo

    hudCombo = 0;



    // ---- COMBO TRACKING (for player's own knockback trigger) ----

    let now = performance.now();


    if(now - player.lastHitTime <= COMBO_HIT_WINDOW_MS){

        player.hitStreak++;

    }
    else{

        player.hitStreak = 1;

    }


    player.lastHitTime = now;



    let comboTriggered = player.hitStreak >= COMBO_HIT_THRESHOLD;

    let damageTriggered = amount >= HIGH_DAMAGE_THRESHOLD;


    if(comboTriggered){

        player.hitStreak = 0;

    }


    if(comboTriggered || damageTriggered){

        triggerPlayerKnockback(sourceX);

    }


}


function damageBoss(boss, amount, sourceX){


    boss.health -= amount;


    // little compress-pop reaction when hit, keeps it feeling soft

    boss.squishVelY += 0.15;

    boss.squishVelX += (Math.random()-0.5)*0.1;


    if(boss.health<0) boss.health=0;



    // ---- HUD COUNTERS ----

    hitsLanded++;

    hudCombo++;


    popStat(hitsValueEl);

    popStat(comboValueEl);



    // ---- QUALIFYING HIT -> SHOVE THE BOSS BACK ----

    if(amount >= BOSS_HIGH_DAMAGE_THRESHOLD){


        triggerBossKnockback(boss, sourceX);


    }


}



// =================================================
// BOSS HIT EFFECT
// flashes at the moment a boss attack actually lands
// on the player - a bright ring + a burst of sparks
// =================================================

function spawnBossHitEffect(x,y,color){


    color = color || "#ff4d4d";


    activeObjects.push({

        type:"bossHit",


        x:x,

        y:y,


        life:1,


        radius:8,

        color:color

    });



    for(let i=0;i<8;i++){


        let angle = Math.random()*Math.PI*2;

        let speed = 3+Math.random()*4;


        activeObjects.push({

            type:"bossHitSpark",


            x:x,

            y:y,


            dx:Math.cos(angle)*speed,

            dy:Math.sin(angle)*speed,


            life:1,

            color:color

        });


    }


}



// =================================================
// BOSS STRIKE EFFECT
// a quick CSS-animated DOM ring (same technique as the
// player's melee-atk-swipe) that flashes right as the
// boss commits to an attack, so the attack telegraphs
// clearly before impact. Converts the world-space origin
// into current screen-space, same as meleeAtkSwipe does.
// =================================================

function spawnBossStrikeEffect(worldX,worldY,facing,color){


    color = color || "#ffffff";


    let screenX = worldX - camera.x;

    let screenY = worldY;


    let el=document.createElement("div");


    el.className="boss-strike-ring";


    el.style.left=(screenX-32)+"px";

    el.style.top=(screenY-32)+"px";


    el.style.borderColor=color;

    el.style.boxShadow="0 0 20px 4px "+color;


    document.body.appendChild(el);



    el.addEventListener("animationend",()=>{


        el.remove();


    });


}



// =================================================
// BOSS DEATH / RESPAWN CYCLE
// instead of vanishing at 0 health, the boss breaks
// apart into its 3 body circles, each tumbling under
// gravity with its own rotation while fading out. once
// every piece has fully faded, a fresh boss spawns back
// on its own side and the fight loop continues. each
// completed cycle counts as a battle won.
// =================================================

const BOSS_RESPAWN_DELAY = 900;

const BOSS_DEATH_PIECE_FADE_RATE = 1/150;


function triggerBossDeath(boss){


    boss.alive=false;

    boss.dying=true;


    boss.deathPieces=[];


    let centerX = boss.x + boss.width/2;

    let stackY = boss.y + boss.height - boss.walkBob;


    for(let i=0;i<boss.radii.length;i++){


        let r = boss.radii[i];


        let wobbleX = boss.circleWobble[i];


        let cx = centerX + wobbleX;

        let cy = stackY - r;


        boss.deathPieces.push({

            x:cx,

            y:cy,

            r:r,


            vx:(Math.random()-0.5)*7,

            vy:-5 - Math.random()*4,


            rotation:0,

            rotationSpeed:(Math.random()-0.5)*0.3,


            life:1

        });


        stackY = cy - r*0.35;


    }


}



function updateBossDeathPieces(boss){


    if(!boss.dying) return;


    let allFaded=true;


    for(let p of boss.deathPieces){


        p.vy += 0.8;


        p.x += p.vx;

        p.y += p.vy;


        p.rotation += p.rotationSpeed;


        p.life -= BOSS_DEATH_PIECE_FADE_RATE;


        if(p.life>0) allFaded=false;


    }


    if(allFaded){


        boss.dying=false;

        boss.deathPieces=[];


        battlesWon++;

        popStat(winsValueEl);


        setTimeout(()=>spawnBoss(boss, boss.side), BOSS_RESPAWN_DELAY);


    }


}



function drawBossDeathPieces(boss){


    if(!boss.dying) return;


    for(let p of boss.deathPieces){


        ctx.save();


        ctx.globalAlpha = Math.max(0,p.life);


        ctx.translate(p.x,p.y);

        ctx.rotate(p.rotation);


        ctx.beginPath();

        ctx.arc(0,0,p.r,0,Math.PI*2);


        ctx.fillStyle="#dfefff";


        ctx.shadowBlur=35;

        ctx.shadowColor="#8fd8ff";


        ctx.fill();


        ctx.lineWidth=3;

        ctx.strokeStyle="#8fd8ff";

        ctx.stroke();


        // a little cracked-line detail so the piece doesn't

        // read as a perfectly clean circle mid-tumble

        ctx.beginPath();

        ctx.moveTo(-p.r*0.4,-p.r*0.3);

        ctx.lineTo(p.r*0.2,p.r*0.1);

        ctx.lineTo(-p.r*0.1,p.r*0.5);

        ctx.strokeStyle="rgba(143,216,255,0.6)";

        ctx.lineWidth=1.5;

        ctx.stroke();


        ctx.restore();


    }


}







// =================================================
// KEY STATE TRACKING (for held keys like Q - fly)
// =================================================

window.addEventListener("keydown",e=>{

    keys[e.key.toLowerCase()]=true;

});



window.addEventListener("keyup",e=>{

    keys[e.key.toLowerCase()]=false;



    // RELEASE SPACE - FIRE WHATEVER CHARGE WAS BUILT UP

    if(e.key===" " && player.charging){


        let chargeLevel = player.chargeFrames / player.maxChargeFrames;


        let cost = SHOT_BASE_COST;

        if(cost > player.power){

            cost = player.power;

        }


        player.power -= cost;


        fireOrb(chargeLevel);


        player.charging=false;

        player.chargeFrames=0;


    }


});



// =================================================
// KEY PRESS ACTIONS
// =================================================

window.addEventListener("keydown",e=>{


let key=e.key.toLowerCase();




// DASH LEFT

if(key==="a" && !dash.cooldown){


let dashStartX = player.x;


player.x-=dash.distance;


player.dashDirection=-1;


player.smear=1;


for(let i=0;i<10;i++){

    let t=i/9;

    spawnFlameParticle("white", {

        x: lerp(dashStartX, player.x, t),

        y: player.y,

        width: player.width,

        height: player.height

    });

}


dash.cooldown=true;


setTimeout(()=>{

dash.cooldown=false;

},dash.cooldownTime);


}






// DASH RIGHT

if(key==="d" && !dash.cooldown){


let dashStartX = player.x;


player.x+=dash.distance;


player.dashDirection=1;


player.smear=1;


for(let i=0;i<10;i++){

    let t=i/9;

    spawnFlameParticle("white", {

        x: lerp(dashStartX, player.x, t),

        y: player.y,

        width: player.width,

        height: player.height

    });

}


dash.cooldown=true;


setTimeout(()=>{

dash.cooldown=false;

},dash.cooldownTime);


}






// JUMP

if(key==="w" && player.grounded){


player.velocityY=-player.jumpPower;


player.grounded=false;


}






// FIRE - handled by charge/release system (see SPACE CHARGE BLAST)



});



// =================================================
// SPAWN A BOSS ON A GIVEN SIDE
// "left" spawns near/left of the player (visible,
// flanking); "right" spawns off the right edge of the
// current screen, same as the original single-boss
// behavior.
// =================================================

function spawnBoss(boss, side){


    boss.alive=true;

    boss.dying=false;

    boss.deathPieces=[];

    boss.health=boss.maxHealth;

    boss.knockbackVX=0;

    boss.side=side;


    if(side==="left"){


        boss.x = clamp(player.x - 400, 0, world.width-boss.width);

        boss.facing = 1;


    }
    else{


        boss.x = camera.x + canvas.width + 150;

        boss.facing = -1;


    }


    boss.y = world.groundY - boss.height;


    boss.vx=0;

    boss.squishX=1;

    boss.squishY=1;

    boss.squishVelX=0;

    boss.squishVelY=0;

    boss.circleWobble=[0,0,0];

    boss.circleWobbleVel=[0,0,0];


    boss.stepIndex=0;

    boss.stepTimer=0;


    enterBossStep(boss, boss.stepStack[boss.stepIndex]);


}



// =================================================
// STEP STACK - CALLED EVERY TIME A BOSS ENTERS
// A NEW BEHAVIOR STATE. RESETS SUB-STATE TIMERS SO
// EACH PHASE STARTS CLEAN.
// =================================================

function enterBossStep(boss, step){


    boss.telegraph=0;


    if(step==="melee"){

        boss.meleeState="idle";

        boss.meleeTimer=0;

        boss.meleeHasHit=false;

    }


    if(step==="charge"){

        boss.chargeState="idle";

        boss.chargeTimer=0;

        boss.chargeHasHit=false;

    }


}





// =================================================
// BOSS BEHAVIOR - SEARCH
// smooth, momentum based approach. no snapping -
// the boss eases its velocity toward a target speed
// so it accelerates/decelerates like it has real mass.
// =================================================

function bossSearch(boss, dx){


    let dist=Math.abs(dx);


    let targetVx = clamp(dx*0.03, -BOSS_WALK_SPEED, BOSS_WALK_SPEED);


    // once fairly close, ease off so it doesn't overshoot/jitter

    if(dist<60){

        targetVx*=dist/60;

    }


    boss.vx += (targetVx-boss.vx)*0.08;


    // visual-only walk hop, driven by current speed

    boss.walkBob = Math.sin(boss.bobTime*4)*Math.min(Math.abs(boss.vx),BOSS_WALK_SPEED)*0.6;


}





// =================================================
// BOSS BEHAVIOR - FIRE
// plants itself, sways gently, periodically winds up
// and lets an orb rip with a recoil pop
// =================================================

function bossFire(boss, dx){


    // ease to a stop rather than braking instantly

    boss.vx += (0-boss.vx)*0.1;


    let cycle = boss.stepTimer % BOSS_FIRE_INTERVAL;

    let windup = Math.floor(BOSS_FIRE_INTERVAL*0.5);


    if(cycle<windup){


        // charging up - compress slightly, more so as it gets closer to firing

        boss.telegraph = cycle/windup;


        boss.squishVelY -= boss.telegraph*0.01;


        spawnFlameParticle("orange", boss);


    }
    else if(cycle===windup){


        let chargeLevel = 0.3 + Math.random()*0.4;


        bossFireOrb(boss, chargeLevel);


        let originX = boss.x + boss.width/2;

        let originY = boss.y + boss.radii[2];


        spawnBossStrikeEffect(originX, originY, boss.facing, "#ffb347");


        boss.telegraph=0;


    }


}





// =================================================
// BOSS BEHAVIOR - MELEE
// anticipate (squat) -> lunge (eased dash toward player,
// NOT an instant teleport) -> hold (impact) -> spring
// back to origin with a soft overshoot bounce
// =================================================

function bossMelee(boss, dx){


    let dist=Math.abs(dx);


    if(boss.meleeState==="idle"){


        // not close enough yet - approach like search until in range

        if(dist>BOSS_MELEE_RANGE){


            bossSearch(boss, dx);

            return;

        }


        boss.meleeState="anticipate";

        boss.meleeTimer=0;

        boss.meleeOriginX=boss.x;

        boss.meleeOriginY=boss.y;

        boss.meleeHasHit=false;


        boss.vx=0;

    }



    if(boss.meleeState==="anticipate"){


        boss.meleeTimer++;


        let t = boss.meleeTimer/BOSS_MELEE_ANTICIPATE_FRAMES;


        boss.telegraph=clamp(t,0,1);


        // squat down and lean back opposite the lunge direction -

        // classic wind-up before a pounce

        boss.squishX = lerp(1,0.72,boss.telegraph);

        boss.squishY = lerp(1,1.35,boss.telegraph);


        if(boss.meleeTimer>=BOSS_MELEE_ANTICIPATE_FRAMES){


            boss.meleeState="lunge";

            boss.meleeTimer=0;

            boss.meleeLungeFromX=boss.x;

            boss.meleeLungeToX=boss.x + boss.facing*(dist*0.85);


            boss.squishVelX += boss.facing*0.25;

            boss.squishVelY -= 0.2;


            spawnBossStrikeEffect(

                boss.x+boss.width/2 + boss.facing*40,

                boss.y+boss.height*0.4,

                boss.facing,

                "#ff5c5c"

            );


        }


    }
    else if(boss.meleeState==="lunge"){


        boss.meleeTimer++;


        let t=clamp(boss.meleeTimer/BOSS_MELEE_LUNGE_FRAMES,0,1);

        let eased=easeInCubic(t);


        boss.x = lerp(boss.meleeLungeFromX, boss.meleeLungeToX, eased);


        // stretched out along the direction of travel

        boss.squishX = lerp(0.72,1.3,eased);

        boss.squishY = lerp(1.35,0.75,eased);


        if(!boss.meleeHasHit){


            let pcx=player.x+player.width/2;

            let pcy=player.y+player.height/2;

            let bcx=boss.x+boss.width/2;

            let bcy=boss.y+boss.height/2;


            let d=Math.sqrt((pcx-bcx)**2+(pcy-bcy)**2);


            if(d<=BOSS_HIT_RADIUS+player.width/2){


                damagePlayer(BOSS_MELEE_DAMAGE, bcx);

                boss.meleeHasHit=true;


                spawnBossHitEffect(pcx,pcy,"#ff5c5c");


                boss.squishVelX -= boss.facing*0.3;

                boss.squishVelY += 0.35;


            }


        }


        if(t>=1){


            boss.meleeState="hold";

            boss.meleeTimer=0;


        }


    }
    else if(boss.meleeState==="hold"){


        boss.meleeTimer++;


        if(boss.meleeTimer>=BOSS_MELEE_HOLD_FRAMES){


            boss.meleeState="return";

            boss.meleeTimer=0;

            boss.meleeLungeFromX=boss.x;


        }


    }
    else if(boss.meleeState==="return"){


        boss.meleeTimer++;


        let t=clamp(boss.meleeTimer/BOSS_MELEE_RETURN_FRAMES,0,1);


        // easeOutBack gives it a little overshoot/settle wobble

        // instead of snapping straight back to its spot

        let eased=easeOutBack(t);


        boss.x = lerp(boss.meleeLungeFromX, boss.meleeOriginX, eased);


        boss.squishX = lerp(boss.squishX,1,0.15);

        boss.squishY = lerp(boss.squishY,1,0.15);


        if(t>=1){


            boss.meleeState="idle";

            boss.meleeTimer=0;

            boss.telegraph=0;


        }


    }


}





// =================================================
// BOSS BEHAVIOR - CHARGE
// long telegraphed windup (coil back), then a fast
// eased dash burst toward the player with a stretched
// silhouette and trailing smear, settling with a
// bouncy overshoot instead of stopping dead
// =================================================

function bossCharge(boss, dx){


    let dist=Math.abs(dx);


    if(boss.chargeState==="idle"){


        boss.chargeState="windup";

        boss.chargeTimer=0;

        boss.vx=0;


    }



    if(boss.chargeState==="windup"){


        boss.chargeTimer++;


        let t=boss.chargeTimer/BOSS_CHARGE_WINDUP_FRAMES;


        boss.telegraph=clamp(t,0,1);


        // coil backwards away from the player, compressing

        boss.squishX = lerp(1,0.65,boss.telegraph);

        boss.squishY = lerp(1,1.45,boss.telegraph);


        spawnFlameParticle("orange", boss);


        if(boss.chargeTimer>=BOSS_CHARGE_WINDUP_FRAMES){


            boss.chargeState="dash";

            boss.chargeTimer=0;

            boss.chargeHasHit=false;


            boss.chargeFromX=boss.x;


            let travel=Math.min(dist+40, BOSS_CHARGE_DISTANCE);


            boss.chargeToX = boss.x + boss.facing*travel;


            spawnBossStrikeEffect(

                boss.x+boss.width/2 + boss.facing*50,

                boss.y+boss.height*0.5,

                boss.facing,

                "#c37bff"

            );


        }


    }
    else if(boss.chargeState==="dash"){


        boss.chargeTimer++;


        let t=clamp(boss.chargeTimer/BOSS_CHARGE_DASH_FRAMES,0,1);

        let eased=easeOutCubic(t);


        boss.x = lerp(boss.chargeFromX, boss.chargeToX, eased);


        // stretched thin along the dash direction, like a blur

        boss.squishX = lerp(0.65,1.5,t);

        boss.squishY = lerp(1.45,0.65,t);


        spawnFlameParticle("white", boss);

        spawnFlameParticle("white", boss);


        if(!boss.chargeHasHit){


            let pcx=player.x+player.width/2;

            let pcy=player.y+player.height/2;

            let bcx=boss.x+boss.width/2;

            let bcy=boss.y+boss.height/2;


            let d=Math.sqrt((pcx-bcx)**2+(pcy-bcy)**2);


            if(d<=BOSS_HIT_RADIUS+player.width/2){


                damagePlayer(BOSS_CHARGE_DAMAGE, bcx);

                boss.chargeHasHit=true;


                spawnBossHitEffect(pcx,pcy,"#c37bff");


            }


        }


        if(t>=1){


            boss.chargeState="settle";

            boss.chargeTimer=0;


        }


    }
    else if(boss.chargeState==="settle"){


        boss.chargeTimer++;


        let t=clamp(boss.chargeTimer/BOSS_CHARGE_SETTLE_FRAMES,0,1);


        boss.squishX = lerp(boss.squishX,1,0.12);

        boss.squishY = lerp(boss.squishY,1,0.12);


        boss.telegraph = lerp(boss.telegraph,0,0.1);


        if(t>=1){


            boss.chargeState="idle";

            boss.telegraph=0;


        }


    }


}





// =================================================
// UPDATE A SINGLE BOSS
// (called once per frame for each boss in `bosses`)
// =================================================

function updateBoss(boss){


    // HEALTH HIT ZERO - KICK OFF THE DEATH/RESPAWN CYCLE
    // INSTEAD OF JUST VANISHING

    if(boss.alive && boss.health<=0 && !boss.dying){


        triggerBossDeath(boss);


    }


    if(!boss.alive) return;


    boss.bobTime += 0.06;



    // ---- STEP STACK CYCLING ----

    boss.stepTimer++;


    if(boss.stepTimer>=boss.stepDuration){


        boss.stepTimer=0;

        boss.stepIndex=(boss.stepIndex+1)%boss.stepStack.length;


        enterBossStep(boss, boss.stepStack[boss.stepIndex]);


    }



    let currentStep = boss.stepStack[boss.stepIndex];


    let dx = (player.x+player.width/2) - (boss.x+boss.width/2);


    if(Math.abs(dx)>4){

        boss.facing = dx>=0 ? 1 : -1;

    }



    if(currentStep==="search") bossSearch(boss, dx);

    else if(currentStep==="fire") bossFire(boss, dx);

    else if(currentStep==="melee") bossMelee(boss, dx);

    else if(currentStep==="charge") bossCharge(boss, dx);



    // ---- INTEGRATE HORIZONTAL MOVEMENT ----
    // (melee lunge/return and charge dash directly set boss.x
    // themselves via easing, so only add vx when nothing else
    // is actively overriding position this frame)

    let posLocked =

        (currentStep==="melee" && boss.meleeState!=="idle") ||

        (currentStep==="charge" && boss.chargeState!=="idle" && boss.chargeState!=="windup");


    if(!posLocked){

        boss.x += boss.vx;

    }



    // ---- KNOCKBACK (from a qualifying player hit) ----
    // same slide-and-decay feel as the player's own
    // knockback, plus a matching dust trail while sliding

    if(boss.knockbackVX){


        boss.x += boss.knockbackVX;


        boss.knockbackVX *= KNOCKBACK_DECAY;


        if(Math.abs(boss.knockbackVX)<0.4){

            boss.knockbackVX=0;

        }


        if(Math.abs(boss.knockbackVX)>1){

            spawnDustParticle(boss);

        }


    }



    // ---- GRAVITY / GROUND ----

    boss.velocityY += boss.gravity;

    boss.y += boss.velocityY;


    if(boss.y+boss.height >= world.groundY){


        if(boss.velocityY>6){

            boss.squishVelY -= boss.velocityY*0.015;

        }


        boss.y = world.groundY-boss.height;

        boss.velocityY=0;

        boss.grounded=true;


    }
    else{

        boss.grounded=false;

    }



    // ---- WORLD LIMITS ----

    if(boss.x<0) boss.x=0;

    if(boss.x+boss.width>world.width) boss.x=world.width-boss.width;



    // ---- SQUASH & STRETCH SPRING BACK TO NORMAL ----

    let sx=springStep(boss.squishX,boss.squishVelX,1,0.05,0.35);

    boss.squishX=sx[0]; boss.squishVelX=sx[1];


    let sy=springStep(boss.squishY,boss.squishVelY,1,0.05,0.35);

    boss.squishY=sy[0]; boss.squishVelY=sy[1];



    // ---- PER-CIRCLE JELLY WOBBLE (secondary motion) ----
    // each circle springs toward a slightly-delayed sine
    // target, driven by current speed, so the stack of
    // circles trails and jiggles instead of moving as one
    // rigid block

    let speedFactor = Math.min(Math.abs(boss.vx)+Math.abs(boss.velocityY)*0.2, 10);


    for(let i=0;i<3;i++){


        let target = Math.sin(boss.bobTime*3 + i*1.1) * (1.5 + speedFactor*0.4);


        let w=springStep(boss.circleWobble[i], boss.circleWobbleVel[i], target, 0.12, 0.45);


        boss.circleWobble[i]=w[0];

        boss.circleWobbleVel[i]=w[1];


    }


}







// =================================================
// UPDATE GAME
// =================================================

function update(){



// SPACE CHARGE BLAST (HOLD SPACE TO CHARGE, RELEASE TO FIRE)

if(keys[" "] && player.power>0){


player.charging=true;


if(player.chargeFrames < player.maxChargeFrames){

player.chargeFrames++;

}


player.power -= CHARGE_DRAIN_PER_FRAME;


if(player.power<0)

player.power=0;


}
else{


player.charging=false;


}


// FLAME FX WHILE CHARGING

if(player.charging){


spawnFlameParticle("orange");

spawnFlameParticle("orange");


}



// POWER CHARGE (HOLD S)

player.regening = false;


if(keys["s"]){


player.regening = true;


player.power += POWER_REGEN_PER_FRAME;


if(player.power>player.maxPower)

player.power=player.maxPower;


spawnFlameParticle("orange");

spawnFlameParticle("orange");


}



updateFlameParticles();








// FLY (HOLD Q)

if(keys["q"]){


player.flying=true;


let targetX = mouse.x + camera.x - player.width/2;

let targetY = mouse.y - player.height/2;


player.x += (targetX - player.x) * 0.18;

player.y += (targetY - player.y) * 0.18;


if(player.y+player.height > world.groundY){

player.y = world.groundY - player.height;

}


player.velocityY=0;

player.grounded=false;


}
else{


player.flying=false;




// GRAVITY

player.velocityY += player.gravity;


player.y += player.velocityY;






// GROUND COLLISION

if(player.y+player.height >= world.groundY){


player.y=world.groundY-player.height;


player.velocityY=0;


player.grounded=true;


}


}





// KNOCKBACK (from combo/damage-triggered hit feedback)
// - now a proper slide (~150px) with a trailing dust
// puff while the player is being pushed across the ground

if(player.knockbackVX){


player.x += player.knockbackVX;


player.knockbackVX *= KNOCKBACK_DECAY;


if(Math.abs(player.knockbackVX)<0.4){

player.knockbackVX=0;

}


if(Math.abs(player.knockbackVX)>1){

spawnDustParticle(player);

}


}







// WORLD LIMITS

if(player.x<0)

player.x=0;



if(player.x+player.width>world.width)

player.x=world.width-player.width;







// CAMERA (dead-zone follow)
// Only scroll the camera once the player nears the
// left/right edge of the screen, instead of locking
// the player to the exact center at all times.

let screenX = player.x - camera.x;


if(screenX > canvas.width - cameraDeadzone){

camera.x = player.x - (canvas.width - cameraDeadzone);

}
else if(screenX < cameraDeadzone){

camera.x = player.x - cameraDeadzone;

}



if(camera.x<0)

camera.x=0;



if(camera.x>world.width-canvas.width)

camera.x=world.width-canvas.width;







// SMEAR FADE

if(player.smear>0)

player.smear-=0.08;



// SCREEN SHAKE COUNTDOWN

if(screenShake.time>0){

screenShake.time--;

}






updateActiveObjects();


// both bosses run their own independent step stack -

// fully simultaneous, neither waits for the other

for(let b of bosses){

    updateBoss(b);

    updateBossDeathPieces(b);

}



}







// =================================================
// DRAW A SINGLE BOSS
// snowman stack of 3 circles, bottom to top, with
// squash/stretch + per-circle wobble applied so it
// reads as a soft, living body instead of 3 stiff dots
// =================================================

function drawBoss(boss){


    if(!boss.alive) return;


    let centerX = boss.x + boss.width/2;

    let baseY = boss.y + boss.height - boss.walkBob;


    let color = "#dfefff";

    let glowColor = "#8fd8ff";


    let currentStep = boss.stepStack[boss.stepIndex];


    if(currentStep==="fire"){ glowColor="#ffb347"; }

    if(currentStep==="melee"){ glowColor="#ff5c5c"; }

    if(currentStep==="charge"){ glowColor="#c37bff"; }



    // trailing smear during the charge dash - motion blur feel

    if(currentStep==="charge" && boss.chargeState==="dash"){


        ctx.save();


        ctx.filter="blur(12px)";

        ctx.globalAlpha=0.5;

        ctx.fillStyle=glowColor;


        ctx.beginPath();

        ctx.ellipse(

            centerX - boss.facing*60, baseY-60,

            60,40,0,0,Math.PI*2

        );

        ctx.fill();


        ctx.restore();


    }



    let stackY = baseY;


    // big soft outer halo behind the whole snowman so the glow
    // reads clearly from a distance, not just a thin rim per-circle

    ctx.save();

    ctx.filter="blur(30px)";

    ctx.globalAlpha=0.55 + boss.telegraph*0.25;

    ctx.fillStyle=glowColor;

    ctx.beginPath();

    ctx.ellipse(centerX, baseY-70, 95+boss.telegraph*40, 105+boss.telegraph*40, 0,0,Math.PI*2);

    ctx.fill();

    ctx.restore();


    for(let i=0;i<boss.radii.length;i++){


        let r = boss.radii[i];


        let wobbleX = boss.circleWobble[i];


        let cx = centerX + wobbleX;

        let cy = stackY - r;


        ctx.save();


        ctx.translate(cx,cy);

        ctx.scale(boss.squishX, boss.squishY);


        ctx.beginPath();

        ctx.arc(0,0,r,0,Math.PI*2);


        ctx.fillStyle=color;


        ctx.shadowBlur = 40 + boss.telegraph*55;

        ctx.shadowColor = glowColor;


        ctx.fill();


        ctx.lineWidth=3;

        ctx.strokeStyle=glowColor;

        ctx.stroke();


        ctx.restore();


        stackY = cy - r*0.35;


    }



    // simple eyes on the top circle so it reads as a face/direction

    let headR = boss.radii[2];

    let headCx = centerX + boss.circleWobble[2];

    let headCy = stackY + headR - (headR*0.35);


    ctx.save();

    ctx.fillStyle="#222";

    ctx.beginPath();

    ctx.arc(headCx + boss.facing*5, headCy-2, 3, 0, Math.PI*2);

    ctx.arc(headCx - boss.facing*3, headCy-2, 3, 0, Math.PI*2);

    ctx.fill();

    ctx.restore();



    // health bar above the boss

    let barW=90, barH=8;

    let barX=centerX-barW/2;

    let barY=boss.y-30;


    ctx.save();

    ctx.fillStyle="#222";

    ctx.fillRect(barX,barY,barW,barH);


    let pct=Math.max(0,boss.health/boss.maxHealth);

    ctx.fillStyle="#ff4d4d";

    ctx.fillRect(barX,barY,barW*pct,barH);


    ctx.strokeStyle="#fff";

    ctx.lineWidth=1;

    ctx.strokeRect(barX,barY,barW,barH);

    ctx.restore();


}







// =================================================
// DRAW
// =================================================

function draw(){



ctx.clearRect(

0,

0,

canvas.width,

canvas.height

);





ctx.save();



// SCREEN SHAKE (combo-hit / big-hit / explosion feedback) -

// offsets the whole world render by a small decaying

// random amount

let shakeX=0, shakeY=0;


if(screenShake.time>0){


let power = screenShake.magnitude * (screenShake.time/SHAKE_DURATION_FRAMES);


shakeX = (Math.random()-0.5)*2*power;

shakeY = (Math.random()-0.5)*2*power;


}


ctx.translate(-camera.x + shakeX, shakeY);







// GROUND

ctx.fillStyle="green";


ctx.fillRect(

0,

world.groundY,

world.width,

canvas.height-world.groundY

);







// PLAYER SMEAR

if(player.smear>0){


ctx.save();


ctx.filter="blur(15px)";


ctx.globalAlpha=player.smear;


ctx.fillStyle="red";


ctx.fillRect(

player.x-(player.dashDirection*100),

player.y,

150,

player.height

);


ctx.restore();


}







// FLAME PARTICLES (drawn BEHIND player so the body
// reads clearly against the glow)

drawFlameParticles();



// BOSSES (drawn before the player so the player reads

// on top). both are drawn independently regardless of

// which one(s) are alive/dying at the moment.

for(let b of bosses){

    drawBoss(b);

    drawBossDeathPieces(b);

}







// PLAYER
// (glows via ctx.shadowBlur/shadowColor while charging —
// a plain CSS box-shadow can't apply to canvas-drawn
// shapes, so the glow has to be done on the canvas itself)

ctx.save();


if(player.charging){


    let chargePct = player.chargeFrames / player.maxChargeFrames;


    ctx.shadowBlur = 25 + chargePct*35;

    ctx.shadowColor = "orange";


}
else if(player.regening){


    ctx.shadowBlur = 30;

    ctx.shadowColor = "orange";


}


ctx.fillStyle="red";


ctx.fillRect(

player.x,

player.y,

player.width,

player.height

);


ctx.restore();








// ACTIVE OBJECT DRAW

for(let obj of activeObjects){



if(obj.type==="orb"){


ctx.save();


ctx.shadowBlur=obj.glow;

ctx.shadowColor = obj.owner==="boss" ? "#ff8a3d" : "cyan";


ctx.fillStyle = obj.owner==="boss"

    ? (obj.chargeLevel>0.55 ? "#fff2df" : "#ff8a3d")

    : (obj.chargeLevel>0.55 ? "#eafcff" : "cyan");


ctx.beginPath();


ctx.arc(

obj.x,

obj.y,

obj.size,

0,

Math.PI*2

);


ctx.fill();


ctx.restore();


}






if(obj.type==="bossHit"){


ctx.save();


ctx.globalAlpha=obj.life;


ctx.strokeStyle=obj.color;

ctx.lineWidth=4;


ctx.shadowBlur=20;

ctx.shadowColor=obj.color;


ctx.beginPath();

ctx.arc(obj.x,obj.y,obj.radius,0,Math.PI*2);

ctx.stroke();


ctx.restore();


}



if(obj.type==="bossHitSpark"){


ctx.save();


ctx.globalAlpha=obj.life;


ctx.fillStyle=obj.color;

ctx.shadowBlur=12;

ctx.shadowColor=obj.color;


ctx.beginPath();

ctx.arc(obj.x,obj.y,4*obj.life,0,Math.PI*2);

ctx.fill();


ctx.restore();


}



if(obj.type==="explosion"){


ctx.save();


ctx.fillStyle="orange";


ctx.globalAlpha=obj.life;


ctx.beginPath();


ctx.arc(

obj.x,

obj.y,

obj.radius,

0,

Math.PI*2

);


ctx.fill();


ctx.restore();


}



}





ctx.restore();










}







// =================================================
// HUD ELEMENTS
// =================================================

const healthFill=document.getElementById("healthFill");

const powerFill=document.getElementById("powerFill");


const healthValue=document.getElementById("healthValue");

const powerValue=document.getElementById("powerValue");



const hitsValueEl=document.getElementById("hitsValue");

const comboValueEl=document.getElementById("comboValue");

const winsValueEl=document.getElementById("winsValue");



function updateHUD(){


    let healthPct = Math.max(0,(player.health/player.maxHealth)*100);

    let powerPct = Math.max(0,(player.power/player.maxPower)*100);


    healthFill.style.width = healthPct+"%";

    powerFill.style.width = powerPct+"%";


    healthValue.textContent = Math.round(player.health);

    powerValue.textContent = player.power.toFixed(2);


}



function updateStatsHUD(){


    hitsValueEl.textContent = hitsLanded;

    comboValueEl.textContent = hudCombo;

    winsValueEl.textContent = battlesWon;


}



// =================================================
// GAME LOOP
// =================================================

function loop(){


update();

draw();

updateHUD();

updateStatsHUD();


requestAnimationFrame(loop);


}


loop();


// spawn both bosses at game start - one flanking the

// player on each side, both fully active from the outset

spawnBoss(bosses[0], "left");

spawnBoss(bosses[1], "right");


// stagger their step cycles so they don't transition

// through search/fire/melee/charge in perfect lockstep

bosses[1].stepIndex = 2;

bosses[1].stepTimer = 0;

enterBossStep(bosses[1], bosses[1].stepStack[bosses[1].stepIndex]);



</script>


</body>

</html>
